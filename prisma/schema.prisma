generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              UserRole
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AttendanceAudit[]
  attendanceRecords AttendanceRecord[] @relation("RecordedBy")

  @@map("users")
}

model Guard {
  id                 String                   @id @default(cuid())
  fullName           String
  badgeId            String                   @unique
  phone              String?
  status             GuardStatus              @default(ACTIVE)
  defaultDutyPointId String?
  photoUrl           String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  attendanceRecords  AttendanceRecord[]
  defaultDutyPoint   DutyPoint?               @relation(fields: [defaultDutyPointId], references: [id])
  dailyAssignments   DailyDutyAssignment[]

  @@map("guards")
}

model Zone {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  dutyPoints DutyPoint[]

  @@map("zones")
}

model DutyPoint {
  id                 String                 @id @default(cuid())
  name               String
  zoneId             String
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  attendanceRecords  AttendanceRecord[]
  zone               Zone                   @relation(fields: [zoneId], references: [id])
  guards             Guard[]
  dailyAssignments   DailyDutyAssignment[]

  @@map("duty_points")
}

model Shift {
  id                String                 @id @default(cuid())
  name              String
  startTime         String
  endTime           String
  graceMinutes      Int                    @default(10)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  attendanceRecords  AttendanceRecord[]
  dailyAssignments   DailyDutyAssignment[]

  @@map("shifts")
}

model AttendanceRecord {
  id           String            @id @default(cuid())
  guardId      String
  shiftId      String
  dutyPointId  String
  shiftDate    DateTime
  signInTime   DateTime?
  status       AttendanceStatus
  minutesLate  Int               @default(0)
  remarks      String?
  recordedById String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  auditLogs    AttendanceAudit[]
  dutyPoint    DutyPoint         @relation(fields: [dutyPointId], references: [id])
  guard        Guard             @relation(fields: [guardId], references: [id])
  recordedBy   User              @relation("RecordedBy", fields: [recordedById], references: [id])
  shift        Shift             @relation(fields: [shiftId], references: [id])

  @@unique([guardId, shiftId, shiftDate])
  @@map("attendance_records")
}

model AttendanceAudit {
  id          String           @id @default(cuid())
  recordId    String
  changedById String
  oldValue    Json
  newValue    Json
  changedAt   DateTime         @default(now())
  changedBy   User             @relation(fields: [changedById], references: [id])
  record      AttendanceRecord @relation(fields: [recordId], references: [id])

  @@map("attendance_audits")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model DailyDutyAssignment {
  id          String   @id @default(cuid())
  guardId     String
  dutyPointId String
  shiftId     String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guard     Guard     @relation(fields: [guardId], references: [id])
  dutyPoint DutyPoint @relation(fields: [dutyPointId], references: [id])
  shift     Shift     @relation(fields: [shiftId], references: [id])

  @@unique([guardId, shiftId, date])
  @@map("daily_duty_assignments")
}

enum UserRole {
  SUPERVISOR
  VIEWER
}

enum GuardStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  OFF
  LEAVE
  EXCUSED
}
