# Database connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# NextAuth configuration
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob - guard photos
# Auto-injected on Vercel deployments. For local dev, create a Blob store in the
# Vercel dashboard (Storage > Blob) and copy its read-write token here.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Shared token guarding writes to /api/daily-assignments from public portals
PORTAL_WRITE_TOKEN="change-me-portal-token"

# External portal databases (read-only monitoring for the campus-wide dashboard)
# Copy the DATABASE_URL values from the pcc-vms and psec-inv repos' .env files.
VMS_DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
PSEC_DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
